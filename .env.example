# ──────────────────────────────────────────────────────────────────────────────
# University Document Portal — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend: PostgreSQL (leave blank to use H2 local DB) ──────────────────────
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ── Backend: CORS ─────────────────────────────────────────────────────────────
# Comma-separated production frontend origins to allow cross-origin requests.
# Example: PORTAL_CORS_EXTRA_ORIGINS=https://your-app.vercel.app
PORTAL_CORS_EXTRA_ORIGINS=

# ── React Frontend (Vite prefix required) ─────────────────────────────────────
# Override API base if frontend is deployed separately from the backend.
# Leave blank to use Vite's built-in dev proxy (/api → localhost:8080).
VITE_API_BASE_URL=

# ── Mobile App (Expo) ─────────────────────────────────────────────────────────
# Backend URL for the mobile client.
# Android emulator: http://10.0.2.2:8080/api
# iOS simulator:    http://localhost:8080/api
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api
